{
  "name": "kant-pastebin",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/retirement.test.mjs tests/expiry.test.mjs tests/notice.test.mjs tests/native.test.mjs",
    "test:browser": "npm run build && node --test tests/pastebin.test.mjs",
    "test:native": "npm run build && node --test tests/native-browser.test.mjs",
    "typecheck": "wrangler types && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --var PASTEBIN_ORIGIN:http://127.0.0.1:8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.7.2",
    "esbuild": "0.25.12",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}

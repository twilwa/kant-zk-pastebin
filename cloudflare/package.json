{
  "name": "kant-delve-rooms",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/model.test.mjs tests/rooms.test.mjs tests/api.test.mjs",
    "test:live": "node --test tests/auth.test.mjs",
    "test:browser": "npm run build && node --test tests/browser.test.mjs tests/pastebin.test.mjs",
    "typecheck": "wrangler types && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --var APP_ORIGIN:http://127.0.0.1:8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@atproto/did": "0.5.6",
    "@atproto/jwk-jose": "0.2.4",
    "@atproto/jwk-webcrypto": "0.3.4",
    "@atproto/oauth-client": "0.8.9",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.7.2",
    "esbuild": "0.25.12",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
